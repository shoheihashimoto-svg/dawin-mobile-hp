---
import Layout from './Layout.astro';
interface Props {
  title: string;
  date: string;
  description: string;
  author?: string;
  category?: string;
  image?: string;
}
const { title, date, description, author = '橋本 章平', category = '現場から', image } = Astro.props.frontmatter ?? Astro.props;
const [y, m, d] = date.split('-').map(Number);
const formatted = new Date(y, m - 1, d).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

// 記事の最後に出す「ほかの記事」：今の記事を除いた新しい順に3本
const here = Astro.url.pathname.replace(/\/$/, '');
const others = (Object.values(import.meta.glob('../pages/blog/*.md', { eager: true })) as any[])
  .filter((p) => p.url && p.url.replace(/\/$/, '') !== here)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3);
---
<Layout title={title} description={description} ogImage={image} ogType="article">

<style>
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .hero-bg {
    background: linear-gradient(135deg, #0f0c29, #1a1a6e, #0d47a1, #1565c0, #0f0c29);
    background-size: 400% 400%;
    animation: gradientShift 10s ease infinite;
  }
</style>

<style is:global>
  .prose h2 { font-size: 1.5rem; font-weight: 900; margin: 2.5rem 0 1rem; color: #111827; padding-bottom: 0.5rem; border-bottom: 2px solid #e5e7eb; }
  .prose h3 { font-size: 1.2rem; font-weight: 700; margin: 2rem 0 0.75rem; color: #1d4ed8; }
  .prose p { margin: 1.25rem 0; line-height: 2; color: #374151; }
  .prose ul { margin: 1.25rem 0 1.25rem 1.75rem; }
  .prose li { margin: 0.6rem 0; line-height: 1.9; color: #374151; list-style-type: disc; }
  .prose strong { font-weight: 700; color: #111827; }
  .prose table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; }
  .prose th, .prose td { border: 1px solid #e5e7eb; padding: 0.6rem 0.8rem; text-align: left; color: #374151; }
  .prose th { background: #eff6ff; font-weight: 700; color: #111827; }
  .prose td:last-child { font-variant-numeric: tabular-nums; }
  .prose blockquote { border-left: 4px solid #3b82f6; padding: 0.75rem 1.25rem; color: #4b5563; font-style: italic; margin: 2rem 0; background: #eff6ff; border-radius: 0 0.5rem 0.5rem 0; }
</style>

<!-- Hero -->
<section class="hero-bg relative py-12 px-6 text-white overflow-hidden">
  <div class="absolute inset-0 opacity-5"
    style="background-image: linear-gradient(rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 60px 60px;">
  </div>
  <div class="relative z-10 max-w-3xl mx-auto">
    <a href="/blog" class="text-blue-300 text-xs font-bold tracking-widest uppercase hover:text-white transition-colors">← BLOG 一覧に戻る</a>
    <div class="mt-4 mb-3 flex items-center gap-3">
      <span class="bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full">{category}</span>
      <span class="text-blue-200 text-xs">{formatted}</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-black leading-tight mb-4">{title}</h1>
    <p class="text-blue-100/80">{description}</p>
  </div>
</section>

<!-- 記事本文 -->
<article class="py-16 px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    {image && (
      <img src={image} alt="" width="1200" height="630" class="w-full h-auto rounded-2xl mb-10 border border-gray-100" fetchpriority="high" decoding="async" />
    )}
    <div class="prose">
      <slot />
    </div>
    <!-- 迷っている人向け：LINE相談 -->
    <div class="mt-16 rounded-2xl bg-green-50 border border-green-200 p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-4 md:justify-between">
      <div>
        <p class="font-black text-gray-900 mb-1 [word-break:auto-phrase]">読んで気になったら、LINEで気軽に相談を</p>
        <p class="text-sm text-gray-600">履歴書不要。質問だけでも大丈夫です。</p>
      </div>
      <a href="https://lin.ee/Z7jiZg1" target="_blank" rel="noopener" class="shrink-0 inline-block text-center bg-[#06C755] text-gray-950 font-bold px-6 py-3 rounded-full hover:brightness-95 transition">
        LINEで相談する
      </a>
    </div>

    <!-- ほかの記事 -->
    {others.length > 0 && (
      <section class="mt-12">
        <h2 class="text-lg font-black text-gray-900 mb-4">ほかの記事も読む</h2>
        <div class="grid gap-3 md:grid-cols-3">
          {others.map((p) => (
            <a href={p.url} class="group block rounded-xl border border-gray-200 overflow-hidden hover:border-blue-400 hover:bg-blue-50/50 transition-colors">
              {p.frontmatter.image && <img src={p.frontmatter.image} alt="" width="1200" height="630" loading="lazy" decoding="async" class="w-full h-auto border-b border-gray-100" />}
              <div class="p-4">
              <p class="text-xs text-gray-500 mb-1">{new Date(p.frontmatter.date).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <p class="text-sm font-bold text-gray-900 leading-snug group-hover:text-blue-700">{p.frontmatter.title}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="mt-12 pt-8 border-t border-gray-100 text-center">
      <a href="/blog" class="inline-block border-2 border-blue-600 text-blue-600 font-bold px-8 py-3 rounded-full hover:bg-blue-600 hover:text-white transition-all duration-300 mr-4">
        ← ブログ一覧
      </a>
      <a href="/recruit" class="inline-block bg-blue-600 text-white font-bold px-8 py-3 rounded-full hover:bg-blue-700 transition-all duration-300">
        採用情報を見る →
      </a>
    </div>
  </div>
</article>

</Layout>
